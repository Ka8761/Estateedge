{
  "name": "estateedge",
  "version": "1.0.0",
  "private": true,
  "description": "AI-powered real estate web platform",
  "workspaces": [
    "frontend",
    "backend/gateway",
    "backend/services/*"
  ],
  "scripts": {
    "dev": "concurrently -n gateway,site,ai,user,analytics,frontend -c blue,green,magenta,yellow,cyan,white \"pnpm --filter gateway dev\" \"pnpm --filter site-service dev\" \"pnpm --filter ai-service dev\" \"pnpm --filter user-service dev\" \"pnpm --filter analytics-service dev\" \"pnpm --filter frontend dev\"",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.1",
    "concurrently": "^8.2.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "axios": "^1.16.1",
    "body-parser": "^2.2.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "graphql": "^16.14.0",
    "helmet": "^8.2.0"
  }
}
